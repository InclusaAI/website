{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      // NOTE: Presentation deployment fallback. Revert post-presentation to:
      // "@inclusaai/ui": ["../design-system/packages/ui/src/index.ts"],
      // "@inclusaai/ui/*": ["../design-system/packages/ui/src/*"],
      // "@inclusaai/design-tokens": ["../design-system/packages/design-tokens/src/index.ts"],
      // "@repo/assets": ["../web-apps/packages/assets/src/index.ts"],
      "@repo/assets": [
        "./public/assets/index.ts"
      ],
      "@repo/assets/metadata": [
        "./public/assets/metadata.ts"
      ],
      "@repo/assets/*": [
        "./public/assets/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
